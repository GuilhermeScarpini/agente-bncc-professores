# Banco SQLite local com as habilidades da BNCC e seus embeddings.
DATABASE_URL="file:./bncc.db"

# Chave da API do Gemini (gratuita em https://aistudio.google.com/apikey).
# Depois de definir, rode `npm run db:seed-bncc` uma vez para carregar a BNCC.
GEMINI_API_KEY=""

# Modelo de geração dos planos (opcional). Padrão: gemini-3.5-flash (~4–5 s por plano).
# GEMINI_MODEL="gemini-3.5-flash"
# Raciocínio antes de responder, nos modelos Gemini 3+: low (padrão, mais rápido), medium ou high.
# GEMINI_THINKING_LEVEL="low"

# IA que gera os planos e as provas: "gemini" (padrão) ou "deepseek". Cada pedido pode escolher
# outra com o campo "llm" (e o modelo com "modelo"). A busca por tema continua no Gemini.
# LLM_PROVIDER="gemini"
# Chave da API do DeepSeek (pré-paga, em https://platform.deepseek.com/api_keys).
DEEPSEEK_API_KEY=""
# Modelo do DeepSeek (opcional): deepseek-flash (padrão, mais barato) ou deepseek-v4-pro.
# DEEPSEEK_MODEL="deepseek-flash"
# Raciocínio antes de responder: low (padrão, mais rápido e barato), high ou max.
# DEEPSEEK_EFFORT="low"

# Chave que os sistemas clientes (ex.: turma-social) enviam em "Authorization: Bearer ...".
# Gerada automaticamente pelo scripts/setup-env.mjs na primeira execução.
AGENTE_BNCC_API_KEY="troque-este-valor"

# Páginas de planos ("/") e provas ("/provas"). Use "false" para usar o agente só como API.
DEMO_HABILITADA="true"

# Senha das páginas (quem abre o site digita uma vez; o navegador lembra por 30 dias).
# Sem senha, as páginas ficam abertas em desenvolvimento (npm run dev) e FECHADAS em produção.
# ACESSO_SENHA=""
